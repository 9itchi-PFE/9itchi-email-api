PORT=8085
ENVIRONMENT=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/emails?sslmode=disable
ITCHI_SECRET_KEY=
ITCHI_ENCRYPTION_KEY=
INTERNAL_API_KEY=
INTERNAL_API_KEY_REQUIRED=true
# Optional: events are published to RabbitMQ when set (amqp://guest:guest@localhost:5672/ locally); logged otherwise
RABBITMQ_URL=
AI_API_URL=http://localhost:8083
RESUME_API_URL=http://localhost:8082
JOB_API_URL=http://localhost:8084
TRACKER_API_URL=http://localhost:8086
SCHEDULE_API_URL=http://localhost:8091
PAYMENTS_API_URL=http://localhost:8089
# Recruiter Radar (pkg/recruiters). Contact finders in order: website (free), hunter, apollo, fake (invents people at
# .example domains: development only). Production: RECRUITER_CHAIN=website,hunter,apollo and COMPANY_DISCOVERY=hunter
# (Hunter Discover is free); "none" = no discovery. A source without its key is skipped.
RECRUITER_CHAIN=fake
COMPANY_DISCOVERY=fake
HUNTER_API_KEY=
APOLLO_API_KEY=
# Credits per UTC month: Hunter searches, Apollo reveals
HUNTER_MONTHLY_CAP=50
APOLLO_MONTHLY_CAP=50
# Admin credit tracker (credits reported, admin tokens override the keys above)
STATISTICS_API_URL=http://localhost:8090
